{
  "job": "retail_data_platform.full_pipeline",
  "required_outputs": ["mart.sales_items", "mart.customer_360", "mart.product_performance", "mart.daily_sales", "public.dashboard", "public.forecast", "public.recommendations"],
  "edges": [
    {"input":"raw.orders","output":"staging.orders","transformation":"dbt_staging_cast_and_normalize"},
    {"input":"raw.order_items","output":"staging.order_items","transformation":"dbt_staging_cast"},
    {"input":"raw.product_variants","output":"staging.product_variants","transformation":"dbt_staging_cast"},
    {"input":"raw.products","output":"staging.products","transformation":"dbt_staging_cast_and_trim"},
    {"input":"raw.categories","output":"staging.categories","transformation":"dbt_staging_cast_and_trim"},
    {"input":"raw.brands","output":"staging.brands","transformation":"dbt_staging_cast_and_trim"},
    {"input":"raw.returns","output":"staging.returns","transformation":"dbt_staging_cast_and_normalize"},
    {"input":"raw.return_items","output":"staging.return_items","transformation":"dbt_staging_cast_and_normalize"},
    {"input":"raw.customers","output":"staging.customers","transformation":"dbt_staging_cast_and_trim"},
    {"input":"staging.returns","output":"intermediate.completed_returns","transformation":"completed_return_filter"},
    {"input":"staging.return_items","output":"intermediate.completed_returns","transformation":"refund_aggregation"},
    {"input":"staging.orders","output":"intermediate.sales_enriched","transformation":"paid_order_filter_and_discount_allocation"},
    {"input":"staging.order_items","output":"intermediate.sales_enriched","transformation":"item_financial_reconciliation"},
    {"input":"staging.product_variants","output":"intermediate.sales_enriched","transformation":"cost_enrichment"},
    {"input":"staging.products","output":"intermediate.sales_enriched","transformation":"product_enrichment"},
    {"input":"staging.categories","output":"intermediate.sales_enriched","transformation":"category_enrichment"},
    {"input":"staging.brands","output":"intermediate.sales_enriched","transformation":"brand_enrichment"},
    {"input":"intermediate.completed_returns","output":"intermediate.sales_enriched","transformation":"completed_refund_allocation"},
    {"input":"intermediate.sales_enriched","output":"mart.sales_items","transformation":"dbt_mart_materialization"},
    {"input":"staging.customers","output":"mart.customer_360","transformation":"customer_dimension"},
    {"input":"mart.sales_items","output":"mart.customer_360","transformation":"customer_aggregation"},
    {"input":"mart.sales_items","output":"mart.product_performance","transformation":"product_aggregation"},
    {"input":"mart.sales_items","output":"mart.daily_sales","transformation":"calendar_spine_and_daily_aggregation"},
    {"input":"mart.sales_items","output":"public.dashboard","transformation":"business_kpi_aggregation"},
    {"input":"mart.sales_items","output":"public.forecast","transformation":"temporal_features_and_model"},
    {"input":"mart.sales_items","output":"public.recommendations","transformation":"paid_basket_cooccurrence"}
  ],
  "column_lineage": [
    {"inputs":["staging.order_items.quantity","staging.order_items.unit_price","staging.orders.discount_amount","staging.returns.return_status","staging.return_items.unit_refund_amount"],"output":"mart.sales_items.net_revenue"},
    {"inputs":["mart.sales_items.net_revenue","staging.product_variants.cost_price","staging.order_items.quantity"],"output":"mart.sales_items.gross_profit"},
    {"inputs":["mart.sales_items.order_date","mart.sales_items.net_revenue"],"output":"mart.daily_sales.net_revenue"},
    {"inputs":["mart.sales_items.order_date","mart.sales_items.net_revenue"],"output":"public.dashboard.monthly_revenue"},
    {"inputs":["mart.sales_items.order_date","mart.sales_items.quantity"],"output":"public.forecast.predicted_quantity"},
    {"inputs":["mart.sales_items.order_id","mart.sales_items.product_id"],"output":"public.recommendations.similarity"}
  ]
}
